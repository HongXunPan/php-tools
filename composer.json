{
    "name": "hongxunpan/php-tools",
    "description": "common php tools and functions",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "HongXunPan\\Tools\\": "src/"
        }
    },
    "authors": [
        {
            "name": "HongXunPan",
            "email": "me@kangxuanpeng.com"
        }
    ],
    "require": {
        "php": ">=5.6",
        "hongxunpan/db": "^1.0 || ^2.0",
        "psr/log": "^1.1"
    },
    "scripts": {
        "lint": "@php tests/lint.php",
        "test": "@php tests/run.php"
    },
    "scripts-descriptions": {
        "lint": "检查全部 PHP 文件语法",
        "test": "运行 php-tools 回归测试"
    },
    "config": {
        "platform": {
            "php": "5.6.0"
        },
        "sort-packages": true
    }
}
