{
    "name": "hongxunpan/php-tools",
    "description": "Reusable PHP 5.6+ tools for logging, Redis coordination, encryption, files, and CLI workflows",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "tools",
        "logging",
        "redis",
        "encryption",
        "cli"
    ],
    "homepage": "https://github.com/HongXunPan/php-tools",
    "support": {
        "docs": "https://github.com/HongXunPan/php-tools#readme",
        "issues": "https://github.com/HongXunPan/php-tools/issues",
        "source": "https://github.com/HongXunPan/php-tools"
    },
    "autoload": {
        "psr-4": {
            "HongXunPan\\Tools\\": "src/"
        }
    },
    "authors": [
        {
            "name": "HongXunPan",
            "email": "me@kangxuanpeng.com"
        }
    ],
    "require": {
        "php": ">=5.6",
        "hongxunpan/db": "^1.0",
        "psr/log": "^1.1"
    },
    "scripts": {
        "lint": "@php tests/lint.php",
        "test": "@php tests/run.php"
    },
    "scripts-descriptions": {
        "lint": "检查全部 PHP 文件语法",
        "test": "运行 php-tools 回归测试"
    },
    "config": {
        "platform": {
            "php": "5.6.0"
        },
        "sort-packages": true
    }
}
